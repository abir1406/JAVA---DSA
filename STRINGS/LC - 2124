#LEETCODE-2124. Check if All A's Appears Before All B's

#optimal

class Solution {
    public boolean checkString(String s) {
        boolean seenB = false;
        for(int i=0; i<s.length(); i++){
            if (s.charAt(i)=='b'){
                seenB = true;
            }
            else if(s.charAt(i)=='a' && seenB == true){
                return false;
            }
        }
        return true;
    }
}

