# Leaders in an Array

import java.util.*;

class Solution {
    public List<Integer> leaders(int[] nums) {

        List<Integer> result = new ArrayList<>();

        int n = nums.length;

        int maxRight = nums[n - 1];

        // Last element is always a leader
        result.add(nums[n - 1]);

        for (int i = n - 2; i >= 0; i--) {

            if (nums[i] > maxRight) {

                result.add(nums[i]);

                maxRight = nums[i];
            }
        }

        Collections.reverse(result);

        return result;
    }
}
