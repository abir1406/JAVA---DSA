#LEETCODE - 1089. Duplicate Zeros

class Solution {
    public void duplicateZeros(int[] arr) {

        int n = arr.length;
        int zeroCount = 0;

        for (int i = 0; i < n; i++) {
            if (arr[i] == 0) {
                zeroCount++;
            }
        }

        int i = n - 1;
        int j = n + zeroCount - 1;

        while (i >= 0) {

            if (j < n) {
                arr[j] = arr[i];
            }
            j--;

            if (arr[i] == 0) {

                if (j < n) {
                    arr[j] = 0;
                }

                j--;
            }

            i--;
        }
    }
}