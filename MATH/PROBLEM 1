# 3360. Stone Removal Game

class Solution {
    public boolean canAliceWin(int n) {

        int remove = 10;
        boolean aliceTurn = true;

        while (n >= remove) {

            n = n - remove;
            remove--;

            aliceTurn = !aliceTurn;
        }

        return !aliceTurn;
    }
}

# optimal


class Solution {
    public boolean canAliceWin(int n) {

        int x = 10;
        int count = 0;

        while (n >= x) {
            n = n - x;
            x--;
            count++;
        }

        return count % 2 == 1;
    }
}
