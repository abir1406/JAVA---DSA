# 905. Deletion of the Kth element of Linked List

class Solution {
    public ListNode deleteKthNode(ListNode head, int k) {
        // If the list is empty, return null
        if (head == null) return head;

        // If k is 1, delete the head node
        if (k == 1) {
            ListNode temp = head;
            head = head.next;
            return head;
        }

        int cnt = 0;
        ListNode temp = head;
        ListNode prev = null;

        // Traverse the list to find the k-th node
        while (temp != null) {
            cnt++;
            if (cnt == k) {
                prev.next = prev.next.next;
                break;
            }
            prev = temp;
            temp = temp.next;
        }

        return head;
    }
}