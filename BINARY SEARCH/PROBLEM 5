# Floor and Ceil in Sorted Array

class Solution {
    public int[] getFloorAndCeil(int[] nums, int x) {

        int floor = -1;
        int ceil = -1;

        int low = 0;
        int high = nums.length - 1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            // Exact match
            if (nums[mid] == x) {
                floor = nums[mid];
                ceil = nums[mid];
                break;
            }

            // nums[mid] is smaller than x
            else if (nums[mid] < x) {
                floor = nums[mid];
                low = mid + 1;
            }

            // nums[mid] is greater than x
            else {
                ceil = nums[mid];
                high = mid - 1;
            }
        }

        return new int[]{floor, ceil};
    }
}