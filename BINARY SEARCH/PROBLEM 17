# Koko eating bananas

class Solution {

    public int minimumRateToEatBananas(int[] nums, int h) {

        int low = 1;
        int high = 0;

        for (int i = 0; i < nums.length; i++) {
            high = Math.max(high, nums[i]);
        }

        while (low <= high) {

            int mid = low + (high - low) / 2;

            long hours = 0;

            for (int i = 0; i < nums.length; i++) {
                hours += (nums[i] + (long) mid - 1) / mid;
            }

            if (hours <= h) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
}