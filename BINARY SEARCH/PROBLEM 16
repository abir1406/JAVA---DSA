# Find the smallest divisor

class Solution {

    public int smallestDivisor(int[] nums, int limit) {

        int low = 1;
        int high = 0;

        for (int i = 0; i < nums.length; i++) {
            high = Math.max(high, nums[i]);
        }

        while (low <= high) {

            int mid = low + (high - low) / 2;

            int sum = 0;

            for (int i = 0; i < nums.length; i++) {
                sum += (nums[i] + mid - 1) / mid;
            }

            if (sum <= limit) {
                high = mid - 1;
            }
            else {
                low = mid + 1;
            }
        }

        return low;
    }
}