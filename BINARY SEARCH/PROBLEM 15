# Find Nth root of a number

class Solution {

    public int NthRoot(int N, int M) {

        int low = 1;
        int high = M;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            int result = power(mid, N, M);

            if (result == 1) {
                return mid;
            }
            else if (result == 0) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }

        return -1;
    }

    private int power(int mid, int N, int M) {

        long result = 1;

        for (int i = 1; i <= N; i++) {

            result = result * mid;

            if (result > M) {
                return 2;
            }
        }

        if (result == M) {
            return 1;
        }

        return 0;
    }
}